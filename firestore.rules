rules_version = '2';

// Moorecoin locks Firestore to server-side access only.
//
// No client ever talks to Firestore directly: the browser bundle has no
// Firestore SDK (see public/scripts/) and reaches data exclusively through
// the Express API, which uses the Admin SDK. Admin SDK credentials bypass
// security rules entirely, so denying every client request here costs the
// app nothing and removes the database as an attack surface.
//
// If a future feature genuinely needs direct client reads, add a narrow
// match block for that specific path — do not widen this default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
