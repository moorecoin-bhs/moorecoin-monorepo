# Service account JSON for the Firebase Admin SDK, as a single line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

PORT=5050

# Sign-in allowlist (src/config.js). The server refuses to start if both are
# empty — an open allowlist is treated as a misconfiguration, not a mode.
ALLOWED_EMAIL_DOMAINS=example.edu
# Individual addresses outside those domains, e.g. a bootstrap admin account.
ALLOWED_EMAILS=owner@example.com

# Accounts that are always admins, re-applied on every sign-in.
# Promote-only: admins granted elsewhere keep their role. Every address here
# must also pass the allowlist above, or the server refuses to start.
ADMIN_EMAILS=teacher@example.edu,owner@example.com
